# Copy to `.env` (same folder) and fill in. Expo loads this automatically.
# Only variables prefixed EXPO_PUBLIC_ are readable in the app, and they are
# baked into the JS bundle at build time — never put a secret you can't ship
# in a public app here. For real secrets, use the backend + a proxy token.

# ── Connect the app to the backend ───────────────────────────────────────
# Base URL of the Express server in ../backend (no trailing path, no slash).
#   local dev on a device:   http://<your-computer-LAN-ip>:8787
#   local dev on emulator:   http://10.0.2.2:8787   (Android)   http://localhost:8787 (iOS sim)
#   deployed:                https://kiddocare-api.example.com
EXPO_PUBLIC_AI_PROXY_URL=

# The shared secret. Must equal APP_TOKEN in backend/.env.
# Leave blank only if the backend also has APP_TOKEN blank (local dev).
EXPO_PUBLIC_AI_PROXY_TOKEN=

# ── Optional: talk to OpenAI directly instead of via the backend ─────────
# If EXPO_PUBLIC_AI_PROXY_URL is set, this is ignored.
EXPO_PUBLIC_OPENAI_API_KEY=

# ── Optional: Pixabay photo search key (free) ────────────────────────────
# A key entered in Settings > Pixabay overrides this.
EXPO_PUBLIC_PIXABAY_KEY=

# ── Optional: Pollinations token for live AI drawing (free) ──────────────
# Get one at https://auth.pollinations.ai . Without it, Picture Talk's live
# "Make full picture with AI" and Keep-talking mode are disabled; the instant
# scene and the 14,800-word ARASAAC picture library still work.
EXPO_PUBLIC_POLLINATIONS_TOKEN=

# ── Optional: free-speech agent for Keep-talking mode (free) ─────────────
# A Groq key (https://console.groq.com, no card) lets an LLM turn any spoken
# sentence into scene edits. Without it, the on-device rule parser handles the
# common patterns. An OpenAI key works here too.
EXPO_PUBLIC_GROQ_API_KEY=
